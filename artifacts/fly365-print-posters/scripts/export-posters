#!/usr/bin/env node
// Standalone export; deliberately not wired into either website build.
import { chromium } from "@playwright/test";
import { mkdir, readFile, writeFile } from "node:fs/promises";
import { execFileSync } from "node:child_process";
import { fileURLToPath, pathToFileURL } from "node:url";
import path from "node:path";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const source = path.join(root, "public/posters");
const output = path.join(source, "png");
const width = 1748;
const height = 2480;
const scale = 300 / 96;
const files = [
  ["fixed-front.html", "Fly365_FixedWing_Front.png"],
  ["fixed-back.html", "Fly365_FixedWing_Back.png"],
  ["flex-front.html", "Fly365_Flexwing_Front.png"],
  ["flex-back.html", "Fly365_Flexwing_Back.png"],
];

await mkdir(output, { recursive: true });
const browser = await chromium.launch({
  executablePath: "/repl/tools/bin/chromium",
  headless: true,
  args: ["--no-sandbox"],
});
try {
  const page = await browser.newPage({
    viewport: { width: 559, height: 794 },
    deviceScaleFactor: scale,
  });
  await page.emulateMedia({ media: "print" });
  const session = await page.context().newCDPSession(page);
  for (const [input, name] of files) {
    await page.goto(pathToFileURL(path.join(source, input)).href, { waitUntil: "load" });
    await page.evaluate(async () => {
      await document.fonts.ready;
      await Promise.all([...document.images].map(image => image.decode()));
      window.scrollTo(0, 0);
    });
    // Fractional CSS clip dimensions avoid rounding A5 to a whole CSS pixel.
    // At 300/96 device scale this is exactly the requested 1748 × 2480 raster.
    const { data } = await session.send("Page.captureScreenshot", {
      format: "png",
      fromSurface: true,
      captureBeyondViewport: true,
      clip: { x: 0, y: 0, width: width / scale, height: height / scale, scale: 1 },
    });
    const target = path.join(output, name);
    await writeFile(target, Buffer.from(data, "base64"));
    // Chromium can round fractional clips by one raster pixel. Normalize only
    // that raster rounding and record 300 dpi in the PNG's physical metadata.
    execFileSync("magick", [
      target, "-resize", `${width}x${height}!`,
      "-units", "PixelsPerInch", "-density", "300", target,
    ]);
    const png = await readFile(target);
    const actualWidth = png.readUInt32BE(16);
    const actualHeight = png.readUInt32BE(20);
    if (actualWidth !== width || actualHeight !== height) {
      throw new Error(`Unexpected export size: ${name} ${actualWidth} × ${actualHeight}`);
    }
    console.log(`public/posters/png/${name} — ${actualWidth} × ${actualHeight} px, 300 dpi`);
  }
} finally {
  await browser.close();
}
